<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Library is consumed by the server (and source-linked into Tasks); not packaged on its own. -->
    <IsPackable>false</IsPackable>
    <IsTrimmable>true</IsTrimmable>
    <!-- Keep additions and removals from the shared public contract intentional in all configurations. -->
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
    <!-- Preserve mirrored overload, parameter-ordering, and unused-public-parameter shapes without inline suppressions that would diverge shared sources. -->
    <NoWarn>$(NoWarn);RS0026;RS0027;CA1068;IDE0060</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.NET.ProjectData.Generators\Microsoft.NET.ProjectData.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />

    <PackageReference Include="System.IO.Pipelines" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />

    <AdditionalFiles Include="..\Microsoft.NET.ProjectData.Generators\project-data-schema.json" />
    <InternalsVisibleTo Include="Microsoft.NET.ProjectData.UnitTests" Key="$(VsPublicKey)" />
    <InternalsVisibleTo Include="CSDevKit.Tests" Key="$(VsPublicKey)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DotNetBuildSourceOnly)' != 'true'">
    <!-- The generator depends on System.Text.Json, so pass its runtime dependency closure as /analyzer inputs to the compiler. This is needed for
         us to build under net472 compilers which we do in our test-rebuild validation in CI. -->
    <Analyzer Include="$(PkgSystem_IO_Pipelines)\lib\netstandard2.0\System.IO.Pipelines.dll" />
    <Analyzer Include="$(PkgSystem_Text_Json)\lib\netstandard2.0\System.Text.Json.dll" />
  </ItemGroup>

  <ItemGroup Condition="'$(DotNetBuildSourceOnly)' == 'true'">
    <!-- The generator ProjectReference supplies its DLL to the compiler, not its runtime dependency chain.
         For SourceBuild, supply the bootstrap-compatible packages restored by the generator project.
         This project's PkgSystem_* properties identify its own resolved dependencies, which can differ.
         Bootstrap PackageReferences here would select those versions for this project's dependency
         graph too, even with ExcludeAssets="all". Use explicit package-root paths to keep the compiler's
         generator dependencies separate from this project's product dependencies. -->
    <Analyzer Include="$(NuGetPackageRoot)microsoft.bcl.asyncinterfaces\$(BundledNETCoreAppPackageVersion)\lib\netstandard2.0\Microsoft.Bcl.AsyncInterfaces.dll" />
    <Analyzer Include="$(NuGetPackageRoot)system.collections.immutable\$(BundledNETCoreAppPackageVersion)\lib\netstandard2.0\System.Collections.Immutable.dll" />
    <Analyzer Include="$(NuGetPackageRoot)system.io.pipelines\$(BundledNETCoreAppPackageVersion)\lib\netstandard2.0\System.IO.Pipelines.dll" />
    <Analyzer Include="$(NuGetPackageRoot)system.text.encodings.web\$(BundledNETCoreAppPackageVersion)\lib\netstandard2.0\System.Text.Encodings.Web.dll" />
    <Analyzer Include="$(NuGetPackageRoot)system.text.json\$(BundledNETCoreAppPackageVersion)\lib\netstandard2.0\System.Text.Json.dll" />
  </ItemGroup>

  <ItemGroup>
    <PublicAPI Include="PublicAPI.Shipped.txt" />
    <PublicAPI Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
