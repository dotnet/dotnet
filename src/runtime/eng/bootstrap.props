<Project>
  <PropertyGroup>
    <BootstrapBuildArtifactsDir Condition="'$(BootstrapBuildArtifactsDir)' == ''">$([MSBuild]::NormalizeDirectory('$(ArtifactsDir)', 'bootstrap-build', '$(TargetRid)', '$(Configuration)'))</BootstrapBuildArtifactsDir>
    <BootstrapConsumerCoreCLRArtifactsPath>$([MSBuild]::NormalizeDirectory('$(BootstrapBuildArtifactsDir)', 'bin', 'coreclr', '$(TargetOS).$(TargetArchitecture).$(CoreCLRConfiguration)'))</BootstrapConsumerCoreCLRArtifactsPath>
    <_BootstrapProductCoreCLRArtifactsPath>$([MSBuild]::NormalizeDirectory('$(ArtifactsBinDir)', 'coreclr', '$(TargetOS).$(TargetArchitecture).$(CoreCLRConfiguration)'))</_BootstrapProductCoreCLRArtifactsPath>
    <BootstrapConsumerHostArtifactsPath>$([MSBuild]::NormalizeDirectory('$(BootstrapBuildArtifactsDir)', 'bin', '$(TargetOS)-$(TargetArchitecture).$(HostConfiguration)'))</BootstrapConsumerHostArtifactsPath>
    <BootstrapLayoutDir>$([MSBuild]::NormalizeDirectory('$(ArtifactsDir)', 'bootstrap', '$(TargetRid)'))</BootstrapLayoutDir>
    <BootstrapRefPackDir Condition="'$(BootstrapRefPackDir)' == ''">$(BootstrapLayoutDir)microsoft.netcore.app/ref</BootstrapRefPackDir>
    <BootstrapRuntimePackDir Condition="'$(BootstrapRuntimePackDir)' == ''">$(BootstrapLayoutDir)microsoft.netcore.app/lib</BootstrapRuntimePackDir>
    <BootstrapAotSdkDir Condition="'$(BootstrapAotSdkDir)' == ''">$(BootstrapLayoutDir)aotsdk</BootstrapAotSdkDir>
    <BootstrapHostDir Condition="'$(BootstrapHostDir)' == ''">$(BootstrapLayoutDir)host</BootstrapHostDir>
    <BootstrapRidGraphDir Condition="'$(BootstrapRidGraphDir)' == ''">$(BootstrapLayoutDir)ridgraph</BootstrapRidGraphDir>
    <BootstrapPropertiesToRemove>EnableBootstrap;BootstrapMainBuild;BootstrapBuildLane;BootstrapBuildArtifactsDir;CrossgenSmokeTestCoreLibPath;CdacReaderArtifactsPath;CoreCLRCrossILCompilerDir</BootstrapPropertiesToRemove>
    <_BootstrapLayoutProperties>BootstrapRefPackDir=$(BootstrapRefPackDir);BootstrapRuntimePackDir=$(BootstrapRuntimePackDir);BootstrapAotSdkDir=$(BootstrapAotSdkDir);BootstrapHostDir=$(BootstrapHostDir);BootstrapRidGraphDir=$(BootstrapRidGraphDir)</_BootstrapLayoutProperties>
    <_BootstrapConsumerProperties>UseBootstrap=true;ArtifactsDir=$(BootstrapBuildArtifactsDir);CoreCLROverridePath=$(_BootstrapProductCoreCLRArtifactsPath);LibrariesOverridePath=$(BootstrapBuildArtifactsDir);LibrariesAllConfigurationsOverridePath=$(BootstrapBuildArtifactsDir);HostArtifactsPath=$(BootstrapConsumerHostArtifactsPath);$(_BootstrapLayoutProperties);CreateHardLinksForCopyFilesToOutputDirectory=false;CreateHardLinksForCopyLocalIfPossible=false;CreateHardLinksForPublishFilesIfPossible=false</_BootstrapConsumerProperties>
    <_BootstrapPackageProperties>UseBootstrap=true;CoreCLROverridePath=$(BootstrapConsumerCoreCLRArtifactsPath);CoreCLRCrossILCompilerDir=$(_BootstrapProductCoreCLRArtifactsPath)$(BuildArchitecture)/ilc/;BootstrapBuildArtifactsDir=$(BootstrapBuildArtifactsDir);$(_BootstrapLayoutProperties);CrossgenSmokeTestCoreLibPath=$(_BootstrapProductCoreCLRArtifactsPath)IL/System.Private.CoreLib.dll</_BootstrapPackageProperties>
  </PropertyGroup>
</Project>
