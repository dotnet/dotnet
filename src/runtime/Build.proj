<Project Sdk="Microsoft.Build.Traversal">

  <PropertyGroup>
    <_OrchestrateBootstrap Condition="'$(EnableBootstrap)' == 'true' and '$(BootstrapBuildLane)' != 'true'">true</_OrchestrateBootstrap>
  </PropertyGroup>

  <Import Project="$(RepositoryEngineeringDir)bootstrap.props" Condition="'$(_OrchestrateBootstrap)' == 'true'" />

  <ItemGroup Condition="'$(_OrchestrateBootstrap)' != 'true'">
    <ProjectReference Include="$(RepoTasksDir)tasks.proj" BuildInParallel="false" />
    <!-- Subsets.props which defines @(ProjectToBuild) is already imported in Directory.Build.props. -->
    <ProjectReference Include="@(ProjectToBuild)" />
  </ItemGroup>

  <ItemGroup Condition="'$(_OrchestrateBootstrap)' == 'true'">
    <ProjectReference Include="$(RepositoryEngineeringDir)main-build.proj"
                      AdditionalProperties="EnableBootstrap=false;BootstrapMainBuild=true"
                      GlobalPropertiesToRemove="BootstrapBuildLane;BootstrapBuildArtifactsDir"
                      UndefineProperties="BootstrapBuildLane;BootstrapBuildArtifactsDir"
                      BuildInParallel="true" />
    <ProjectReference Include="$(RepositoryEngineeringDir)bootstrap.proj"
                      AdditionalProperties="BootstrapBuildLane=true;BootstrapBuildArtifactsDir=$(BootstrapBuildArtifactsDir)"
                      BuildInParallel="true"
                      Pack="false"
                      Publish="false" />
  </ItemGroup>

  <Target Name="BuildBootstrapPackages"
          AfterTargets="Build;Pack"
          Condition="'$(_OrchestrateBootstrap)' == 'true'">
    <MSBuild Projects="@(BootstrapPackageProject)"
             Targets="Restore"
             Properties="$(_BootstrapPackageProperties)"
             BuildInParallel="false"
             StopOnFirstFailure="true" />
    <MSBuild Projects="@(BootstrapPackageProject)"
             Properties="$(_BootstrapPackageProperties);ExcludeRestorePackageImports=false"
             BuildInParallel="false"
             StopOnFirstFailure="true" />
    <MSBuild Projects="@(BootstrapCdacPackageProject)"
             Targets="Restore"
             Properties="CdacReaderArtifactsPath=$(BootstrapConsumerCoreCLRArtifactsPath)" />
    <MSBuild Projects="@(BootstrapCdacPackageProject)"
             Properties="CdacReaderArtifactsPath=$(BootstrapConsumerCoreCLRArtifactsPath);ExcludeRestorePackageImports=false" />
  </Target>

  <Target Name="BuildBootstrapTests"
          AfterTargets="Build"
          Condition="'$(_OrchestrateBootstrap)' == 'true' and '@(BootstrapTestProject)' != ''">
    <MSBuild Projects="@(BootstrapTestProject)"
             Targets="Restore"
             Properties="UseBootstrap=true"
             RemoveProperties="$(BootstrapPropertiesToRemove)"
             StopOnFirstFailure="true" />
    <MSBuild Projects="@(BootstrapTestProject)"
             Properties="UseBootstrap=true;ExcludeRestorePackageImports=false"
             RemoveProperties="$(BootstrapPropertiesToRemove)"
             StopOnFirstFailure="true" />
  </Target>

  <Target Name="TestBootstrapTests"
          AfterTargets="Test"
          Condition="'$(_OrchestrateBootstrap)' == 'true' and '@(BootstrapTestProject)' != ''">
    <MSBuild Projects="@(BootstrapTestProject)"
             Targets="Test"
             Properties="UseBootstrap=true;ExcludeRestorePackageImports=false"
             RemoveProperties="$(BootstrapPropertiesToRemove)"
             StopOnFirstFailure="true" />
  </Target>

  <Target Name="VSTestBootstrapTests"
          AfterTargets="VSTest"
          Condition="'$(_OrchestrateBootstrap)' == 'true' and '@(BootstrapTestProject)' != ''">
    <MSBuild Projects="@(BootstrapTestProject)"
             Targets="VSTest"
             Properties="UseBootstrap=true;ExcludeRestorePackageImports=false"
             RemoveProperties="$(BootstrapPropertiesToRemove)"
             StopOnFirstFailure="true" />
  </Target>

  <Import Project="$(RepositoryEngineeringDir)SubsetValidation.targets" />
  <Import Project="$(RepositoryEngineeringDir)restore\optimizationData.targets" Condition="'$(DotNetBuildSourceOnly)' != 'true'" />
  <Import Project="$(RepositoryEngineeringDir)bootstrap-layout.targets" Condition="'$(Subset)' == 'bootstrap' and '$(_OrchestrateBootstrap)' != 'true'" />

</Project>
