# The connection-identity sources are linked into every servicing branch from this one folder and
# are deliberately byte-identical across all of them, so a difference between two branches is always
# a real difference and never a reformatting artifact.
#
# This line sets csharp_style_prefer_switch_expression to warning, which becomes an error under
# warnAsError, while the branches this file is shared with set it to suggestion. Reformatting the
# file to satisfy the stricter setting here would make it differ from every other branch, so the
# rule is scoped down for this folder instead. The switch statement stays a switch statement.
[*.cs]
csharp_style_prefer_switch_expression = true:suggestion
dotnet_diagnostic.IDE0066.severity = suggestion
