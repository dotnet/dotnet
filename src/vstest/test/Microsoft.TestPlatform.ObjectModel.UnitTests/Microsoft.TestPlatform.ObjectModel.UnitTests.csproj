<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TestProject>true</TestProject>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net11.0;net481</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>Microsoft.TestPlatform.ObjectModel.UnitTests</AssemblyName>
    <!-- Tests cover the experimental xxHash128 test id API, so they call it on purpose. -->
    <NoWarn>$(NoWarn);VSTEST001</NoWarn>
  </PropertyGroup>
</Project>
