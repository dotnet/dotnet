<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <TestCaseFilter>TestCategory=Compatibility</TestCaseFilter>
    <TreatNoTestsAsError>true</TreatNoTestsAsError>
  </RunConfiguration>
  <TestRunParameters>
    <Parameter name="BuildCompatibility" value="true" />
  </TestRunParameters>
</RunSettings>
