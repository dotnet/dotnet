<?xml version="1.0" encoding="utf-8"?>
<Project>
    <!-- BinSkim Auto-Remediation Targets -->
    <!-- Generated by SecurityIntegration.RemediationTsg -->
    <!-- Rules: BA2024, BA2026 -->

    <Target Name="BinSkim_AutoRemediation" BeforeTargets="ClCompile">
        <PropertyGroup>
            <_BinSkim_IsCpp Condition="'@(ClCompile)' != '' or '$(CLToolExe)' != ''">true</_BinSkim_IsCpp>
        </PropertyGroup>

        <!-- C++ Remediations -->
        <ItemGroup Condition="'$(_BinSkim_IsCpp)' == 'true'">
            <ClCompile>
                <SpectreMitigation>Spectre</SpectreMitigation> <!-- BA2024 -->
                <SDLCheck>true</SDLCheck> <!-- BA2026 -->
            </ClCompile>
        </ItemGroup>
    </Target>
</Project>