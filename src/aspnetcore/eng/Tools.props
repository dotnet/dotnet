<Project>
  <!-- Update the generated files when we restore projects. -->
  <Target Name="GenerateDirectoryBuildFiles"
      AfterTargets="Restore">
    <!--
      Separate invocations with a distinct global property set so that the second one re-evaluates the
      project and can load the package info written by the first one. _GenerateFilesPass is only used to
      make the two global property sets differ; without it both calls would share a single project
      instance and GenerateFileFromTemplate would be unavailable on a clean checkout.
    -->
    <MSBuild Projects="$(RepoRoot)eng\tools\GenerateFiles\GenerateFiles.csproj"
        Properties="_GenerateFilesPass=Restore"
        Targets="Restore" />
    <MSBuild Projects="$(RepoRoot)eng\tools\GenerateFiles\GenerateFiles.csproj"
        Properties="_GenerateFilesPass=Generate"
        Targets="GenerateDirectoryBuildFiles" />
  </Target>
</Project>
