<Project>

  <PropertyGroup>
    <MicrosoftDotNetBuildTasksFileCatalogTaskAssembly>$(MSBuildThisFileDirectory)..\tools\net\Microsoft.DotNet.Build.Tasks.FileCatalog.dll</MicrosoftDotNetBuildTasksFileCatalogTaskAssembly>
  </PropertyGroup>

  <UsingTask TaskName="Microsoft.DotNet.Build.Tasks.FileCatalog.GenerateFileCatalog" AssemblyFile="$(MicrosoftDotNetBuildTasksFileCatalogTaskAssembly)" Runtime="NET" />

</Project>
