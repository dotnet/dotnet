<Project Sdk="Microsoft.Build.NoTargets" TreatAsLocalProperty="PackageVersion">
  <PropertyGroup>
    <TargetFramework>$(SdkTargetFramework)</TargetFramework>
    <PackageId>Microsoft.NET.Sdk.Emscripten.Version.Internal</PackageId>
    <EmscriptenPackageVersion>$(MicrosoftNETRuntimeEmscriptenInternalPackageVersion)</EmscriptenPackageVersion>
    <PackageVersion>$(EmscriptenPackageVersion)</PackageVersion>
    <PackageDescription>The Emscripten package version selected by the 1xx .NET SDK. For internal dependency flow only.</PackageDescription>
    <IsPackable>true</IsPackable>
    <IsShippingPackage>false</IsShippingPackage>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EmscriptenVersionFile>$(IntermediateOutputPath)EmscriptenVersion.txt</EmscriptenVersionFile>
    <GenerateNuspecDependsOn>_GenerateEmscriptenVersion;$(GenerateNuspecDependsOn)</GenerateNuspecDependsOn>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(EmscriptenVersionFile)" Pack="true" PackagePath="data" />
  </ItemGroup>

  <Import Project="..\Emscripten.targets" />

  <Target Name="_GenerateEmscriptenVersion"
          DependsOnTargets="_ValidateEmscriptenPackageVersion">
    <Error Condition="'$(EmscriptenVersionCurrent)' == ''" Text="EmscriptenVersionCurrent is required to publish the SDK Emscripten version marker." />
    <WriteLinesToFile File="$(EmscriptenVersionFile)"
                      Lines="$(EmscriptenVersionCurrent)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(EmscriptenVersionFile)" />
    </ItemGroup>
  </Target>
</Project>
