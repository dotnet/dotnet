<Project Sdk="Microsoft.Build.NoTargets">

  <Import Project="$(MSBuildThisFileDirectory)$(MSBuildProjectName).props" />

  <PropertyGroup>
    <SourceRevisionId>9db92a4e978b4ae432183c790259be48a475578f</SourceRevisionId>
    <OpenTelemetryReleaseVersion>$(OpenTelemetryDotNet118ReleaseVersion)</OpenTelemetryReleaseVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- AOT analysis requires ILLink tooling that is not available in the SBA package feed. -->
    <EnvironmentVariables Include="IsAotCompatible=false" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)opentelemetry-dotnet.targets" />

</Project>
