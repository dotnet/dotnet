<Project Sdk="Microsoft.Build.NoTargets">

  <!-- Per-component overrides and validation metadata remain separate so each release
       can be updated independently by update-external-metadata. -->
  <Import Project="$(MSBuildThisFileDirectory)$(MSBuildProjectName).props" />

  <PropertyGroup>
    <SourceRevisionId>611868a27afda59761da60b98610f8d3b85497dc</SourceRevisionId>
    <OpenTelemetryReleaseVersion>$(OpenTelemetryDotNetReleaseVersion)</OpenTelemetryReleaseVersion>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)opentelemetry-dotnet.targets" />

</Project>
