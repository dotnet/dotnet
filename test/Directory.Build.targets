<Project>

  <Import Project="..\Directory.Build.targets" />

  <!-- Point the test application's app host at the repo-local .NET installation.

       The test projects build an app host (xunit.v3 requires one) and Microsoft.Testing.Platform launches that
       executable directly rather than through the dotnet muxer. An app host ignores PATH: it resolves a runtime
       through DOTNET_ROOT and otherwise falls back to the machine-wide install. Without this the tests silently
       run on whatever .NET is installed on the machine, or fail on a machine that has none.

       Arcade's test targets set this when they invoked the runner, but they are disabled for this repo.
       Microsoft.Testing.Platform's InvokeTestingPlatformTask derives from ToolTask and so supports an
       EnvironmentVariables parameter, but its InvokeTestingPlatform target doesn't plumb one through. ToolTask
       passes the MSBuild process environment on to the child, so set the variable on this process instead.
       MSBuild doesn't allow System.Environment.SetEnvironmentVariable as a property function, hence the task.

       Remove this in favor of setting the environment variable directly on the task once
       https://github.com/microsoft/testfx/issues/10342 is fixed. -->
  <UsingTask TaskName="SetEnvironmentVariable"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Name ParameterType="System.String" Required="true" />
      <Value ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">System.Environment.SetEnvironmentVariable(Name, Value);</Code>
    </Task>
  </UsingTask>

  <Target Name="SetDotNetRootForTestRun"
          Condition="'$(IsTestProject)' == 'true' and '$(DotNetRoot)' != ''"
          BeforeTargets="InvokeTestingPlatform">
    <SetEnvironmentVariable Name="DOTNET_ROOT" Value="$(DotNetRoot.TrimEnd('\/'))" />
  </Target>

</Project>
